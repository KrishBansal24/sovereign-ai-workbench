*.py[cod]
*$py.class
venv/
.venv/
env/
backend/venv/

# Tests and coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/

# Environment configuration (keep safe templates)
.env
.env.*
!.env.example
backend/.env
backend/.env.*
