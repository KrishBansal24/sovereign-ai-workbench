# Local-only Ollama settings. Do not set this to a remote or cloud endpoint.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
GENERAL_MODEL=qwen3:8b
CODING_MODEL=qwen2.5-coder:7b
EMBEDDING_MODEL=nomic-embed-text
RAG_CHUNK_SIZE=3000
RAG_CHUNK_OVERLAP=400
RAG_TOP_K=5
OLLAMA_TIMEOUT_SECONDS=120
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE_MB=20
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
VISION_MODEL=llava:7b
VISION_TIMEOUT_SECONDS=300
OCR_MAX_PAGES=20
OCR_MAX_ATTEMPTS=2
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MAX_OUTPUT_BYTES=20000
SANDBOX_MAX_FILE_BYTES=5000000
SANDBOX_MAX_ARTIFACTS=10
SANDBOX_MAX_REPAIR_ATTEMPTS=2
PDF_MAX_PAGES=500
DOCUMENT_MAX_EXTRACTED_CHARS=5000000
IMAGE_MAX_PIXELS=40000000
